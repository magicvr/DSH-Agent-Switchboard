{
  "name": "@magicvr/dsh-agent-switchboard",
  "version": "0.0.1",
  "private": true,
  "description": "DSH plugin that keeps the main agent as an information switchboard and delegates work to role-specialized subagents, including local CLI backends.",
  "license": "MIT",
  "author": "magicvr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicvr/DSH-Agent-Switchboard.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/switchboard.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.0-rc.2"
  },
  "devDependencies": {
    "yaml": "^2.6.0"
  },
  "scripts": {
    "check": "node scripts/check-roles.mjs && node scripts/check-cli.mjs && node scripts/check-cli-provider.mjs && node scripts/check-config-schema.mjs && node scripts/check-config-volatile.mjs",
    "check:roles": "node scripts/check-roles.mjs",
    "check:cli": "node scripts/check-cli.mjs",
    "check:cli-provider": "node scripts/check-cli-provider.mjs",
    "check:schema": "node scripts/check-config-schema.mjs",
    "check:volatile": "node scripts/check-config-volatile.mjs",
    "check:live": "node scripts/check-cli-live.mjs",
    "check:preset": "node scripts/gen-preset.mjs --check",
    "gen:roles": "node scripts/gen-role-config.mjs",
    "gen:preset": "node scripts/gen-preset.mjs",
    "inject:preset": "node scripts/probe-preset.mjs --inject",
    "toggle:cross-cli": "node scripts/toggle-cross-cli.mjs",
    "probe:codex": "node scripts/probe-codex.mjs"
  }
}

{
  "name": "@magicvr/dsh-agent-switchboard",
  "version": "0.0.1",
  "private": true,
  "description": "DSH plugin that keeps the main agent as an information switchboard and delegates work to role-specialized subagents, including local CLI backends.",
  "license": "MIT",
  "author": "magicvr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicvr/DSH-Agent-Switchboard.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/switchboard.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "devDependencies": {
    "yaml": "^2.6.0"
  },
  "scripts": {
    "check": "node scripts/check-roles.mjs && node scripts/check-drivers.mjs && node scripts/check-cli.mjs && node scripts/check-cli-provider.mjs && node scripts/check-config-schema.mjs && node scripts/check-config-volatile.mjs && node scripts/check-config-file.mjs && node scripts/check-apply.mjs && node scripts/check-validation-parity.mjs && node scripts/check-client.mjs && node scripts/check-profile-wiring.mjs && node scripts/check-version.mjs && node scripts/check-lifecycle.mjs && node scripts/check-script-portability.mjs",
    "check:roles": "node scripts/check-roles.mjs",
    "check:parity": "node scripts/check-validation-parity.mjs",
    "check:drivers": "node scripts/check-drivers.mjs",
    "check:cli": "node scripts/check-cli.mjs",
    "check:cli-provider": "node scripts/check-cli-provider.mjs",
    "check:schema": "node scripts/check-config-schema.mjs",
    "check:volatile": "node scripts/check-config-volatile.mjs",
    "check:file": "node scripts/check-config-file.mjs",
    "check:apply": "node scripts/check-apply.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:wiring": "node scripts/check-profile-wiring.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:lifecycle": "node scripts/check-lifecycle.mjs",
    "plugin:status": "node scripts/ops/plugin-lifecycle.mjs status",
    "plugin:verify": "node scripts/ops/plugin-lifecycle.mjs verify",
    "plugin:install": "node scripts/ops/plugin-lifecycle.mjs install",
    "plugin:upgrade": "node scripts/ops/plugin-lifecycle.mjs upgrade",
    "plugin:uninstall": "node scripts/ops/plugin-lifecycle.mjs uninstall",
    "version:show": "node scripts/ops/plugin-version.mjs show",
    "version:bump": "node scripts/ops/plugin-version.mjs bump",
    "migrate:roles": "node scripts/ops/migrate-roles-to-file.mjs",
    "check:live": "node scripts/probes/check-cli-live.mjs",
    "check:preset": "node scripts/gen-preset.mjs --check",
    "gen:roles": "node scripts/ops/gen-role-config.mjs",
    "gen:preset": "node scripts/gen-preset.mjs",
    "inject:preset": "node scripts/ops/probe-preset.mjs --inject",
    "probe:codex": "node scripts/probes/probe-codex.mjs",
    "check:portability": "node scripts/check-script-portability.mjs"
  }
}
